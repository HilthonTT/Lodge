# Public base URL of the Lodge API (no trailing slash, no /api suffix).
# Docker compose gateway: http://localhost:8000 (the API itself also listens on :5000).
# Used by the browser and, unless API_INTERNAL_BASE_URL is set, by the Next.js server.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# API version segment -> requests go to {base}/api/{version}/...
NEXT_PUBLIC_API_VERSION=v1

# Optional, server-only: base URL the Next.js server uses to reach the API
# (e.g. http://lodge-api:8080 inside docker compose). Defaults to NEXT_PUBLIC_API_BASE_URL.
# API_INTERNAL_BASE_URL=
