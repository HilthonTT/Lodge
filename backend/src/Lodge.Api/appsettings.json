{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Hangfire": "Warning",
        "Microsoft.AspNetCore.DataProtection": "Error"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "Lodge.Api"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "",
    "Cache": "",
    "BlobStorage": ""
  },
  "Jwt": {
    "Issuer": "Lodge",
    "Audience": "lodge.dev",
    "SecurityKey": "",
    "TokenExpirationInMinutes": 60
  },
  "MessageBroker": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "QueueName": "lodge-integration-events"
  },
  "Mail": {
    "SenderDisplayName": "Lodge",
    "SenderEmail": "noreply@lodge.dev",
    "SmtpServer": "",
    "SmtpPort": 587,
    "SmtpPassword": ""
  },
  "BackgroundJobs": {
    "Outbox": {
      "Schedule": "0/10 * * * * *",
      "BatchSize": 20
    },
    "CompleteBookings": {
      "Schedule": "0 3 * * *"
    },
    "ExpireBookingRequests": {
      "Schedule": "*/15 * * * *",
      "ExpiryHours": 24
    },
    "Superhost": {
      "Schedule": "0 4 * * *"
    },
    "Payouts": {
      "Schedule": "0 5 * * *"
    },
    "PublishReviews": {
      "Schedule": "30 3 * * *"
    },
    "Reminders": {
      "Schedule": "0 8 * * *"
    },
    "Experiences": {
      "CompleteSchedule": "15 3 * * *",
      "ExpireHoldsSchedule": "*/15 * * * *",
      "PaymentHoldMinutes": 60
    }
  },
  "Hosting": {
    "Superhost": {
      "MinCompletedStays": 5,
      "MinAverageRating": 4.8,
      "MaxCancellationRate": 0.10
    }
  },
  "BlobStorage": {
    "ContainerName": "files"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Assets": {
    "PublicBaseUrl": ""
  },
  "App": {
    "FrontendBaseUrl": "http://localhost:3000",
    "ApiPublicBaseUrl": "http://localhost:8000"
  },
  "Authentication": {
    "External": {
      "Google": {
        "ClientId": "",
        "ClientSecret": ""
      },
      "GitHub": {
        "ClientId": "",
        "ClientSecret": ""
      }
    }
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "SeedDemoData": false
  },
  "Payments": {
    "Mode": "",
    "GuestServiceFeePercent": 12,
    "HostServiceFeePercent": 3,
    "DefaultTaxRatePercent": 0
  },
  "Currencies": {
    "Base": "USD"
  },
  "Stripe": {
    "ReturnUrl": "http://localhost:3000/bookings",
    "SecretKey": "",
    "WebhookSecret": "",
    "ConnectWebhookSecret": ""
  }
}
