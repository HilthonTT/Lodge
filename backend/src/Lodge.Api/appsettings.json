{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Hangfire": "Warning",
        "Microsoft.AspNetCore.DataProtection": "Error"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "Lodge.Api"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "",
    "Cache": "",
    "BlobStorage": ""
  },
  "Jwt": {
    "Issuer": "Lodge",
    "Audience": "lodge.dev",
    "SecurityKey": "",
    "TokenExpirationInMinutes": 60
  },
  "MessageBroker": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "QueueName": "lodge-integration-events"
  },
  "Mail": {
    "SenderDisplayName": "Lodge",
    "SenderEmail": "noreply@lodge.dev",
    "SmtpServer": "",
    "SmtpPort": 587,
    "SmtpPassword": ""
  },
  "BackgroundJobs": {
    "Outbox": {
      "Schedule": "0/10 * * * * *",
      "BatchSize": 20
    },
    "CompleteBookings": {
      "Schedule": "0 3 * * *"
    }
  },
  "BlobStorage": {
    "ContainerName": "files"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Assets": {
    "PublicBaseUrl": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "SeedDemoData": false
  },
  "Stripe": {
    "ReturnUrl": "http://localhost:3000/bookings",
    "SecretKey": "",
    "WebhookSecret": ""
  }
}
