{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Hangfire": "Warning",
        "Microsoft.AspNetCore.DataProtection": "Error"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://localhost:5341" }
      }
    ]
  },
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=lodge;Username=postgres;Password=postgres;Include Error Detail=true",
    "Cache": "localhost:6379",
    "BlobStorage": "UseDevelopmentStorage=true"
  },
  "Jwt": {
    "SecurityKey": "development-only-signing-key-change-me-0123456789"
  },
  "Mail": {
    "SmtpServer": "localhost",
    "SmtpPort": 1025
  },
  "Assets": {
    "PublicBaseUrl": "http://localhost:5000"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true,
    "SeedDemoData": true
  }
}
