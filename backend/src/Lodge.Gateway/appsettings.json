{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning",
      "Microsoft.AspNetCore.DataProtection": "Error"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "PermitLimitPerMinute": 600
  },
  "ReverseProxy": {
    "Routes": {
      "lodge-api": {
        "ClusterId": "lodge-api",
        "RateLimiterPolicy": "per-ip",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "lodge-api": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": {
          "ActivityTimeout": "00:01:40"
        },
        "Destinations": {
          "api-1": {
            "Address": "http://localhost:5000"
          }
        }
      }
    }
  }
}
