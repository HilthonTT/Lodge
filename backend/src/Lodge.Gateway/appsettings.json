{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning",
      "Microsoft.AspNetCore.DataProtection": "Error"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "PermitLimitPerMinute": 600
  },
  "ReverseProxy": {
    "Routes": {
      "lodge-hubs": {
        "ClusterId": "lodge-hubs",
        "Order": -1,
        "RateLimiterPolicy": "Disable",
        "Match": {
          "Path": "/hubs/{**catch-all}"
        }
      },
      "lodge-api": {
        "ClusterId": "lodge-api",
        "RateLimiterPolicy": "per-ip",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "lodge-hubs": {
        "LoadBalancingPolicy": "RoundRobin",
        "SessionAffinity": {
          "Enabled": true,
          "Policy": "HashCookie",
          "FailurePolicy": "Redistribute",
          "AffinityKeyName": ".Lodge.Hubs.Affinity",
          "Cookie": {
            "HttpOnly": true,
            "SameSite": "Lax",
            "SecurePolicy": "SameAsRequest"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:02:00"
        },
        "Destinations": {
          "api-1": {
            "Address": "http://localhost:5000"
          }
        }
      },
      "lodge-api": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": {
          "ActivityTimeout": "00:01:40"
        },
        "Destinations": {
          "api-1": {
            "Address": "http://localhost:5000"
          }
        }
      }
    }
  }
}
